<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS entitlements for the bundled app (tauri.conf.json bundle.macOS).
     `tauri dev` runs unsigned, so outside the sandbox. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Folders and files the user picks in an open or save panel. Read
         and write, so a playlist (M3U8) or the user's data can be exported
         to the file they name (PLAN.md F1, F20); nothing else is written. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Security-scoped bookmarks that keep that access across launches
         (library/access.rs, core/src/FolderAccess_apple.mm). -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Outgoing connections: MusicBrainz and Cover Art Archive (Phase 4). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Incoming connections: the LAN remote (PLAN.md O14), which listens
         only while the user has it on and answers only local addresses. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
