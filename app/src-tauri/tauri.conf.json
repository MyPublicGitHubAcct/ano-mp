{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ano-mp",
  "version": "0.1.0",
  "identifier": "dev.anomp.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ano-mp",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./Entitlements.plist",
      "frameworks": [
        "../../third_party/ffmpeg/macos-universal/lib/libavformat.63.dylib",
        "../../third_party/ffmpeg/macos-universal/lib/libavcodec.63.dylib",
        "../../third_party/ffmpeg/macos-universal/lib/libswresample.7.dylib",
        "../../third_party/ffmpeg/macos-universal/lib/libavutil.61.dylib"
      ],
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
