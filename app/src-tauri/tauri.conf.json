{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ano-mp",
  "version": "0.1.0",
  "identifier": "dev.anomp.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ano-mp",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' anomp-art: data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' anomp-art: data: blob:",
        "connect-src": "ipc: http://ipc.localhost ws:",
        "font-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./Entitlements.plist",
      "frameworks": [
        "../../third_party/ffmpeg/macos-universal/lib/libavformat.63.dylib",
        "../../third_party/ffmpeg/macos-universal/lib/libavcodec.63.dylib",
        "../../third_party/ffmpeg/macos-universal/lib/libswresample.7.dylib",
        "../../third_party/ffmpeg/macos-universal/lib/libavutil.61.dylib"
      ],
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "m4a",
          "m4b",
          "aac",
          "alac",
          "ogg",
          "oga",
          "opus",
          "wav",
          "aif",
          "aiff",
          "aifc",
          "wma",
          "wv",
          "ape"
        ],
        "name": "Audio file",
        "description": "An audio file ano-mp can play",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "Playlist",
        "description": "An M3U playlist",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
